# ================================
# Node.js Git Ignore
# ================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Environment variables
.env
.env.local
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# Build output
/dist
/out
/.next
/.nuxt
/.cache
/.serverless
/.build

# Cache
.cache/
.turbo

# Coverage
/coverage
*.lcov

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
/junit.xml

# Package manager specific
package-lock.json
yarn.lock
pnpm-lock.yaml

# Debugger
chrome-user-data
*.pid

# Optional (uncomment if needed)
# /lib
# /temp
# /out-tsc